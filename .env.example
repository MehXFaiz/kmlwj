# ==============================================================================
# GoDaddy Node.js + MySQL Hosting Environment Configuration (godaddy-migration)
# ==============================================================================

# Database Connection
# Option A: Single Connection URL (Recommended)
DATABASE_URL="mysql://USERNAME:PASSWORD@HOST:3306/DATABASE_NAME"

# Option B: Discrete Parameters (Fallback for cPanel / Passenger hosting)
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=your_db_username
# DB_PASSWORD=your_db_password
# DB_NAME=your_db_name

# Server Port (GoDaddy Passenger / Node.js Hosting)
PORT=5000
NODE_ENV=production

# JWT Authentication Secrets
JWT_SECRET=your_production_jwt_secret_here
JWT_REFRESH_SECRET=your_production_jwt_refresh_secret_here

# File Storage — Cloudinary (Optional in local, recommended for cloud storage)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# AI Accounting Health & Auto-Repair (Optional)
OPENROUTER_API_KEY=your_openrouter_api_key_here
