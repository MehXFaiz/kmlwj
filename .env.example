# Neon PostgreSQL — paste your connection string from Neon dashboard or Vercel env vars.
# Use the POOLED connection string for serverless (ends with -pooler...neon.tech).
# Example: postgresql://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Auth secret (generate a strong random string — required for login/signup)
# Example: openssl rand -base64 32
JWT_SECRET=

# Local dev
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Public app URL (used for password reset links)
APP_URL=http://localhost:5173

# Optional: override API proxy target for Vite (default http://localhost:4000)
# VITE_API_URL=http://localhost:4000
