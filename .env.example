# Neon PostgreSQL (use pooled connection string on Vercel serverless)
# Example: postgresql://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Auth secrets (generate strong random strings for production)
JWT_SECRET=
JWT_REFRESH_SECRET=

# Local dev
PORT=4000
CORS_ORIGIN=http://localhost:5173

# Public app URL (used for password reset links)
APP_URL=http://localhost:5173

# Optional: override API proxy target for Vite (default http://localhost:4000)
# VITE_API_URL=http://localhost:4000
