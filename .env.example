# Neon PostgreSQL connection strings
DATABASE_URL=postgresql://user:password@ep-xxx-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require&pgbouncer=true
DIRECT_URL=postgresql://user:password@ep-xxx.us-east-1.aws.neon.tech/neondb?sslmode=require

# JWT Configuration
JWT_SECRET=your_jwt_access_secret_here
JWT_REFRESH_SECRET=your_jwt_refresh_secret_here

# Local Server Config
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173
APP_URL=http://localhost:5173

# File Storage — Cloudinary (REQUIRED in production / on Vercel)
# The app is deployed as Vercel serverless functions, which have a read-only,
# non-persistent filesystem — local disk storage cannot work there. Uploads go
# directly from the browser to Cloudinary via a signature from /api/v1/upload/sign.
# Get these values from https://console.cloudinary.com → Dashboard → API Keys,
# and set them BOTH here (for local testing of the cloud path) AND in the Vercel
# project settings (Settings → Environment Variables) for production.
# If left unset in local development, uploads fall back to the ./uploads folder.
CLOUDINARY_CLOUD_NAME=your_cloud_name_here
CLOUDINARY_API_KEY=your_api_key_here
CLOUDINARY_API_SECRET=your_api_secret_here
# Optional: Cloudinary folder for member images (default: kmlwj/members)
# CLOUDINARY_FOLDER=kmlwj/members

# AI Accounting Health & Auto-Repair — server-side only, never exposed to the
# frontend. Without this key, AI Analyze reports "not configured" and the
# rest of the feature (detection, safe auto-repair, history) still works.
# Get a key from https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Optional override. Verify this is still a current model id at
# https://docs.anthropic.com/en/docs/about-claude/models before relying on
# it in production — Anthropic periodically retires older model ids.
# ANTHROPIC_MODEL=claude-sonnet-4-5-20250929
