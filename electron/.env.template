# KMLWJ Desktop — runtime configuration
# This file lives at %APPDATA%\kmlwj\.env (per-user, writable without admin
# rights) and is NOT bundled with real secrets in the installer. Fill in the
# values below, save, then restart the app.

# PostgreSQL connection (Neon or any standard Postgres). Required.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
DIRECT_URL=postgresql://user:password@host/dbname?sslmode=require

# JWT signing secrets — use long random strings, keep them private. Required.
JWT_SECRET=
JWT_REFRESH_SECRET=

NODE_ENV=production
# 0 = let the OS pick a free port automatically (recommended). Set a fixed
# number only if you specifically need a stable local port.
PORT=0

# File storage — Cloudinary (required for member photos / attachments).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
