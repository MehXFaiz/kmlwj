{
  "buildCommand": "node scripts/compile-api-shared.mjs && prisma generate && prisma migrate deploy && vite build",
  "outputDirectory": "dist",
  "framework": "vite",
  "functions": {
    "api/index.ts": {
      "includeFiles": "api/{_prisma.js,_utils/**,_services/**,_middlewares/**,_config/**,_auth/**,_v1/**,_health.js}"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.ts" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
