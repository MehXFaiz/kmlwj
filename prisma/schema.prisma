generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                   String          @id @default(uuid()) @db.Uuid
  fullName             String
  email                String          @unique
  password             String
  isActive             Boolean         @default(true)
  roleId               String          @db.Uuid
  role                 Role            @relation(fields: [roleId], references: [id])
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  refreshTokens            RefreshToken[]
  auditLogs                AuditLog[]
  donationsCreated         Donation[]          @relation("DonationCreatedBy")
  hallBookingsCreated      HallBooking[]       @relation("HallBookingCreatedBy")
  incomesCreated           SimpleIncome[]      @relation("IncomeCreatedBy")
  expensesCreated          SimpleExpense[]     @relation("ExpenseCreatedBy")
  invoicesCreated          Invoice[]           @relation("InvoiceCreatedBy")
  revenueCollections       RevenueCollection[] @relation("RevenueCollectionCreatedBy")
  donationsReceivedCreated DonationReceived[]  @relation("DonationReceivedCreatedBy")
}

model Role {
  id              String           @id @default(uuid()) @db.Uuid
  name            String           @unique
  description     String?
  users           User[]
  rolePermissions RolePermission[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Permission {
  id              String           @id @default(uuid()) @db.Uuid
  name            String           @unique
  description     String?
  rolePermissions RolePermission[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model RolePermission {
  id           String     @id @default(uuid()) @db.Uuid
  roleId       String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String     @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([roleId, permissionId])
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  token     String    @unique
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
}

enum AccountLevel {
  MAIN       // Level 1 — Root categories (Assets, Liabilities, Revenue, Expenses)
  PARENT     // Level 2 — Sub-categories (Current Assets, Hall Income, etc.)
  SUBSIDIARY // Level 3 — Posting groups / headers (Cash & Bank, Hall Booking, etc.)
  GL         // Level 4 — Individual GL accounts (HBL Bank, Bagh-e-Hajiani, etc.) — User editable
}


model Account {
  id                String             @id @default(uuid()) @db.Uuid
  glCode            String             @unique
  accountName       String
  accountLevel      AccountLevel
  parentId          String?            @db.Uuid
  parent            Account?           @relation("AccountChildren", fields: [parentId], references: [id])
  children          Account[]          @relation("AccountChildren")
  accountTypeId     String?            @db.Uuid
  accountType       AccountType?       @relation(fields: [accountTypeId], references: [id])
  isLocked          Boolean            @default(false)
  isReserved        Boolean            @default(false)
  isSystemDefined   Boolean            @default(false)
  description       String?
  currency          String             @default("PKR")
  subsidiary        String[]           @default(["Global"])
  initialBalance    Float              @default(0)
  currentBalance    Float              @default(0)
  detailType        String             @default("Header")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  revenueHeads      RevenueHead[]
  expenseHeads      ExpenseHead[]
  journalEntryLines JournalEntryLine[]
  ledgerEntries          LedgerEntry[]
  donations              Donation[]          @relation("DonationBankAccount")
  invoices               Invoice[]           @relation("InvoiceBankAccount")
  hallBookings           HallBooking[]       @relation("HallBookingAccount")
  hallBookingBanks       HallBooking[]       @relation("HallBookingBankAccount")
  revenueCollections     RevenueCollection[] @relation("RevenueCollectionBankAccount")
  donationsReceivedCash  DonationReceived[]  @relation("DonationReceivedCashAccount")
  donationsReceivedBank  DonationReceived[]  @relation("DonationReceivedBankAccount")
}

model AccountType {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique
  description String?
  accounts    Account[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ReservedCode {
  id            String   @id @default(uuid()) @db.Uuid
  reserveStart  String   @unique
  reserveEnd    String
  reserveReason String
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model RevenueHead {
  id            String         @id @default(uuid()) @db.Uuid
  name          String
  category      String
  hall          String?
  amount        Float?         @default(0)
  accountId     String?        @db.Uuid
  account       Account?       @relation(fields: [accountId], references: [id])
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  simpleIncomes SimpleIncome[]
}

model ExpenseHead {
  id             String          @id @default(uuid()) @db.Uuid
  name           String
  category       String
  accountId      String?         @db.Uuid
  account        Account?        @relation(fields: [accountId], references: [id])
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  simpleExpenses SimpleExpense[]
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  module    String
  oldValues Json?
  newValues Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
}

model JournalEntry {
  id          String             @id @default(uuid()) @db.Uuid
  voucherNo   String             @unique
  postingDate DateTime
  subsidiary  String
  reference   String
  description String?
  postedBy    String
  status      String             @default("Draft")
  voucherType String             @default("JV")
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  lines       JournalEntryLine[]
  hallBooking HallBooking?       @relation("HallBookingJournalEntry")
  revenueCollection RevenueCollection? @relation("RevenueCollectionJournalEntry")
  donationReceived DonationReceived?   @relation("DonationReceivedJournalEntry")
}

model JournalEntryLine {
  id             String       @id @default(uuid()) @db.Uuid
  journalEntryId String       @db.Uuid
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      String       @db.Uuid
  account        Account      @relation(fields: [accountId], references: [id])
  description    String?
  debit          Float        @default(0)
  credit         Float        @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model LedgerEntry {
  id          String   @id @default(uuid()) @db.Uuid
  accountId   String   @db.Uuid
  account     Account  @relation(fields: [accountId], references: [id])
  debit       Float    @default(0)
  credit      Float    @default(0)
  reference   String
  description String?
  postingDate DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

enum DonationType {
  MONTHLY
  MARRIAGE
  MEDICAL
  EMERGENCY
  EDUCATION
  CUSTOM
  GENERAL_DONATION
  ZAKAT
  FITRA
  SADQA
  QURBANI
  HALL_DONATION
  MARRIAGE_DONATION
  BUILDING_FUND
  MEDICAL_DONATION
  EDUCATION_DONATION
}

enum PaymentMethod {
  CASH
  BANK
  CHEQUE
  ONLINE
}

enum TransactionStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum DonationStatus {
  PENDING
  APPROVED
  CANCELLED
}

model Beneficiary {
  id        String     @id @default(uuid()) @db.Uuid
  name      String
  cnic      String?    @unique
  mobile    String?
  address   String?
  remarks   String?
  isActive  Boolean    @default(true)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  donations Donation[]
}

model Donation {
  id             String         @id @default(uuid()) @db.Uuid
  beneficiaryId  String?        @db.Uuid
  beneficiary    Beneficiary?   @relation(fields: [beneficiaryId], references: [id])
  donorName      String?
  donorMobile    String?
  donationType   DonationType
  amount         Float
  paymentMethod  PaymentMethod
  bankAccountId  String?        @db.Uuid
  bankAccount    Account?       @relation("DonationBankAccount", fields: [bankAccountId], references: [id])
  chequeNumber   String?
  donorBankName  String?
  remarks        String?
  status         DonationStatus @default(PENDING)
  createdById    String?        @db.Uuid
  createdBy      User?          @relation("DonationCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
}

// ── Simple Income ─────────────────────────────────────────────
model SimpleIncome {
  id             String      @id @default(uuid()) @db.Uuid
  date           DateTime    @default(now())
  revenueHeadId  String      @db.Uuid
  revenueHead    RevenueHead @relation(fields: [revenueHeadId], references: [id])
  description    String?
  amount         Float
  paymentMethod  String      @default("CASH")
  bankAccountId  String?     @db.Uuid
  reference      String?
  journalEntryId String?     @db.Uuid
  createdById    String?     @db.Uuid
  createdBy      User?       @relation("IncomeCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime    @default(now())
}

// ── Simple Expense ────────────────────────────────────────────
model SimpleExpense {
  id             String      @id @default(uuid()) @db.Uuid
  date           DateTime    @default(now())
  expenseHeadId  String      @db.Uuid
  expenseHead    ExpenseHead @relation(fields: [expenseHeadId], references: [id])
  paidTo         String?
  description    String?
  amount         Float
  paymentMethod  String      @default("CASH")
  bankAccountId  String?     @db.Uuid
  reference      String?
  journalEntryId String?     @db.Uuid
  createdById    String?     @db.Uuid
  createdBy      User?       @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  createdAt      DateTime    @default(now())
}

model HallBooking {
  id                String         @id @default(uuid()) @db.Uuid
  bookingDate       DateTime       @default(now())
  receiptNo         Int            @default(autoincrement())
  bookerName        String
  fatherHusbandName String?
  address           String?
  mobile            String?
  programDate       DateTime
  programType       String?
  functionType      String?
  timeFrom          String?
  timeTo            String?
  timings           String?
  hallId            String?        @db.Uuid
  hallAccount       Account?       @relation("HallBookingAccount", fields: [hallId], references: [id])
  isForJamaat       Boolean        @default(false)
  amount            Float
  discount          Float?         @default(0)
  netAmount         Float?
  receivedAmount    Float?
  paymentMethod     PaymentMethod
  bankAccountId     String?        @db.Uuid
  bankAccount       Account?       @relation("HallBookingBankAccount", fields: [bankAccountId], references: [id])
  chequeNumber      String?
  chequeBankName    String?
  status            String         @default("Confirmed")
  remarks           String?
  createdById       String?        @db.Uuid
  createdBy         User?          @relation("HallBookingCreatedBy", fields: [createdById], references: [id])
  journalEntryId    String?        @unique @db.Uuid
  journalEntry      JournalEntry?  @relation("HallBookingJournalEntry", fields: [journalEntryId], references: [id])
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@unique([hallId, programDate], name: "hallId_programDate")
}

model Customer {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  email     String?
  phone     String?
  address   String?
  company   String?
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  invoices  Invoice[]
}

model Invoice {
  id            String        @id @default(uuid()) @db.Uuid
  invoiceNo     String        @unique
  customerId    String        @db.Uuid
  customer      Customer      @relation(fields: [customerId], references: [id])
  issueDate     DateTime
  dueDate       DateTime
  status        String        @default("DRAFT") // DRAFT, POSTED, PAID, CANCELLED
  subtotal      Float
  discount      Float         @default(0)
  tax           Float         @default(0)
  total         Float
  paymentMethod String?       // CASH, BANK, CHEQUE
  bankAccountId String?       @db.Uuid
  bankAccount   Account?      @relation("InvoiceBankAccount", fields: [bankAccountId], references: [id])
  chequeNumber  String?
  remarks       String?
  items         InvoiceItem[]
  createdById   String?       @db.Uuid
  createdBy     User?         @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

model InvoiceItem {
  id          String   @id @default(uuid()) @db.Uuid
  invoiceId   String   @db.Uuid
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Float
  unitPrice   Float
  amount      Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RevenueCollection {
  id              String         @id @default(uuid()) @db.Uuid
  category        String         // "Zakat", "Fitra", "Membership Fee", "Bus Booking"
  receiptNo       Int            @default(autoincrement())
  title           String         // Donor Name / Member Name / Booker Name
  subTitle        String?        // CNIC / Member ID / Bus Number / Destination
  mobile          String?
  eventDate       DateTime?      // Trip Date / Fee Year / Collection Date
  quantity        Int?           // Head Count / Seats
  rate            Float?         // Rate per Head / Fee Rate
  destination     String?
  amount          Float
  paymentMethod   PaymentMethod  @default(CASH)
  bankAccountId   String?        @db.Uuid
  bankAccount     Account?       @relation("RevenueCollectionBankAccount", fields: [bankAccountId], references: [id])
  chequeNumber    String?
  status          String         @default("Confirmed")
  remarks         String?
  createdById     String?        @db.Uuid
  createdBy       User?          @relation("RevenueCollectionCreatedBy", fields: [createdById], references: [id])
  journalEntryId  String?        @unique @db.Uuid
  journalEntry    JournalEntry?  @relation("RevenueCollectionJournalEntry", fields: [journalEntryId], references: [id])
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model Member {
  id              String         @id @default(uuid()) @db.Uuid
  memberNo        String?        @unique
  fullName        String
  fatherName      String?
  cnic            String?        @unique
  dob             String?
  address         String?
  mobile          String?
  email           String?
  city            String?
  area            String?
  ghamName        String?
  education       String?
  profession      String?
  company         String?
  doi             String?
  photoUrl        String?        @db.Text
  isActive        Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
}

model Donor {
  id              String   @id @default(uuid()) @db.Uuid
  donorCode       String   @unique
  fullName        String
  fatherName      String?
  mobile          String?
  cnic            String?  @unique
  email           String?
  address         String?
  city            String?
  isActive        Boolean  @default(true)
  donations       DonationReceived[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model DonationReceived {
  id                String            @id @default(uuid()) @db.Uuid
  receiptNo         String            @unique
  receiptDate       DateTime          @default(now())
  donorId           String            @db.Uuid
  donor             Donor             @relation(fields: [donorId], references: [id])
  donationType      DonationType
  amount            Float
  paymentMethod     PaymentMethod
  cashAccountId     String?           @db.Uuid
  cashAccount       Account?          @relation("DonationReceivedCashAccount", fields: [cashAccountId], references: [id])
  bankAccountId     String?           @db.Uuid
  bankAccount       Account?          @relation("DonationReceivedBankAccount", fields: [bankAccountId], references: [id])
  chequeNo          String?
  chequeDate        DateTime?
  referenceNo       String?
  narration         String?
  journalEntryId    String?           @unique @db.Uuid
  journalEntry      JournalEntry?     @relation("DonationReceivedJournalEntry", fields: [journalEntryId], references: [id])
  status            TransactionStatus @default(POSTED)
  createdById       String            @db.Uuid
  createdBy         User              @relation("DonationReceivedCreatedBy", fields: [createdById], references: [id])
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([receiptDate])
  @@index([donorId])
  @@index([paymentMethod])
}

