generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                   String          @id @default(uuid()) @db.Uuid
  fullName             String
  email                String          @unique
  password             String
  isActive             Boolean         @default(true)
  roleId               String          @db.Uuid
  role                 Role            @relation(fields: [roleId], references: [id])
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  themePreference      String?         // 'light' | 'dark' | 'system' — null = use client default
  isDeleted            Boolean         @default(false)
  deletedAt            DateTime?
  deletedBy            String?         @db.Uuid
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  refreshTokens            RefreshToken[]
  auditLogs                AuditLog[]
  donationsCreated         Donation[]          @relation("DonationCreatedBy")
  hallBookingsCreated      HallBooking[]       @relation("HallBookingCreatedBy")
  incomesCreated           SimpleIncome[]      @relation("IncomeCreatedBy")
  expensesCreated          SimpleExpense[]     @relation("ExpenseCreatedBy")
  invoicesCreated          Invoice[]           @relation("InvoiceCreatedBy")
  revenueCollections       RevenueCollection[] @relation("RevenueCollectionCreatedBy")
  donationsReceivedCreated DonationReceived[]  @relation("DonationReceivedCreatedBy")
  zakatCardsCreated        ZakatCard[]         @relation("ZakatCardCreatedBy")
  addIncomesCreated        AddIncomeRecord[]   @relation("AddIncomeCreatedBy")

  @@index([isDeleted])
}

model Role {
  id              String           @id @default(uuid()) @db.Uuid
  name            String           @unique
  description     String?
  users           User[]
  rolePermissions RolePermission[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Permission {
  id              String           @id @default(uuid()) @db.Uuid
  name            String           @unique
  description     String?
  rolePermissions RolePermission[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model RolePermission {
  id           String     @id @default(uuid()) @db.Uuid
  roleId       String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String     @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([roleId, permissionId])
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  token     String    @unique
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
}

enum AccountLevel {
  MAIN       // Level 1 — Root categories (Assets, Liabilities, Revenue, Expenses)
  PARENT     // Level 2 — Sub-categories (Current Assets, Hall Income, etc.)
  SUBSIDIARY // Level 3 — Posting groups / headers (Cash & Bank, Hall Booking, etc.)
  GL         // Level 4 — Individual GL accounts (NBP Bank, Bagh-e-Hajiani, etc.) — User editable
}


model Account {
  id                String             @id @default(uuid()) @db.Uuid
  glCode            String             @unique
  accountName       String
  accountLevel      AccountLevel
  parentId          String?            @db.Uuid
  parent            Account?           @relation("AccountChildren", fields: [parentId], references: [id])
  children          Account[]          @relation("AccountChildren")
  accountTypeId     String?            @db.Uuid
  accountType       AccountType?       @relation(fields: [accountTypeId], references: [id])
  isLocked          Boolean            @default(false)
  isReserved        Boolean            @default(false)
  isSystemDefined   Boolean            @default(false)
  description       String?
  currency          String             @default("PKR")
  subsidiary        String[]           @default(["Global"])
  // Monetary columns (initialBalance, currentBalance) are Decimal(18,2)
  initialBalance    Decimal            @default(0) @db.Decimal(18, 2)
  currentBalance    Decimal            @default(0) @db.Decimal(18, 2)
  detailType        String             @default("Header")
  isDeleted         Boolean            @default(false)
  deletedAt         DateTime?
  deletedBy         String?            @db.Uuid
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  revenueHeads      RevenueHead[]
  expenseHeads      ExpenseHead[]
  journalEntryLines JournalEntryLine[]
  donations              Donation[]          @relation("DonationBankAccount")
  invoices               Invoice[]           @relation("InvoiceBankAccount")
  hallBookings           HallBooking[]       @relation("HallBookingAccount")
  hallBookingBanks       HallBooking[]       @relation("HallBookingBankAccount")
  revenueCollections     RevenueCollection[] @relation("RevenueCollectionBankAccount")
  donationsReceivedCash  DonationReceived[]  @relation("DonationReceivedCashAccount")
  donationsReceivedBank  DonationReceived[]  @relation("DonationReceivedBankAccount")
  incomeCategoryAccounts IncomeCategory[]
  addIncomeBanks         AddIncomeRecord[]   @relation("AddIncomeBankAccount")

  // Tree-building (parent lookups) and level-scoped scans hit these constantly.
  @@index([parentId])
  @@index([accountLevel])
  @@index([isDeleted])
}

model AccountType {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique
  description String?
  accounts    Account[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ReservedCode {
  id            String   @id @default(uuid()) @db.Uuid
  reserveStart  String   @unique
  reserveEnd    String
  reserveReason String
  isActive      Boolean   @default(true)
  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?
  deletedBy     String?   @db.Uuid
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([isDeleted])
}

model RevenueHead {
  id            String         @id @default(uuid()) @db.Uuid
  name          String
  category      String
  hall          String?
  amount        Decimal?       @default(0) @db.Decimal(18, 2)
  accountId     String?        @db.Uuid
  account       Account?       @relation(fields: [accountId], references: [id])
  isActive      Boolean        @default(true)
  isDeleted     Boolean        @default(false)
  deletedAt     DateTime?
  deletedBy     String?        @db.Uuid
  createdAt     DateTime       @default(now())
  simpleIncomes SimpleIncome[]

  @@index([isDeleted])
}

model ExpenseHead {
  id             String          @id @default(uuid()) @db.Uuid
  name           String
  category       String
  accountId      String?         @db.Uuid
  account        Account?        @relation(fields: [accountId], references: [id])
  isActive       Boolean         @default(true)
  isDeleted      Boolean         @default(false)
  deletedAt      DateTime?
  deletedBy      String?         @db.Uuid
  createdAt      DateTime        @default(now())
  simpleExpenses SimpleExpense[]

  @@index([isDeleted])
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  module    String
  oldValues Json?
  newValues Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model JournalEntry {
  id          String             @id @default(uuid()) @db.Uuid
  voucherNo   String             @unique
  postingDate DateTime
  subsidiary  String
  reference   String
  description String?
  postedBy    String
  status      String             @default("Draft")
  voucherType String             @default("JV")
  isDeleted   Boolean            @default(false)
  deletedAt   DateTime?
  deletedBy   String?            @db.Uuid
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  lines       JournalEntryLine[]
  hallBooking HallBooking?       @relation("HallBookingJournalEntry")
  revenueCollection RevenueCollection? @relation("RevenueCollectionJournalEntry")
  donationReceived DonationReceived?   @relation("DonationReceivedJournalEntry")
  zakatCard        ZakatCard?          @relation("ZakatCardJournalEntry")
  addIncomeRecord  AddIncomeRecord?    @relation("AddIncomeJournalEntry")

  // Every financial report filters posted lines by their parent JournalEntry's
  // status (+ posting-date window) via getPostedAggregates — this is the single
  // hottest query in the system.
  @@index([status, postingDate])
  @@index([voucherType, postingDate])
  @@index([isDeleted])
}

model JournalEntryLine {
  id             String       @id @default(uuid()) @db.Uuid
  journalEntryId String       @db.Uuid
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      String       @db.Uuid
  account        Account      @relation(fields: [accountId], references: [id])
  description    String?
  debit          Decimal      @default(0) @db.Decimal(18, 2)
  credit         Decimal      @default(0) @db.Decimal(18, 2)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // getPostedAggregates groups by accountId; delete/recalc paths filter by
  // journalEntryId. Both were previously unindexed (sequential scans).
  @@index([accountId])
  @@index([journalEntryId])
}

enum DonationType {
  MONTHLY
  MARRIAGE
  MEDICAL
  EMERGENCY
  EDUCATION
  CUSTOM
  GENERAL_DONATION
  ZAKAT
  FITRA
  SADQA
  QURBANI
  HALL_DONATION
  MARRIAGE_DONATION
  BUILDING_FUND
  MEDICAL_DONATION
  EDUCATION_DONATION
}

enum PaymentMethod {
  CASH
  BANK
  CHEQUE
  ONLINE
}

enum TransactionStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum DonationStatus {
  PENDING
  APPROVED
  CANCELLED
}

model Beneficiary {
  id              String      @id @default(uuid()) @db.Uuid
  name            String
  fatherName      String?
  husbandName     String?
  cnic            String?     @unique
  dob             DateTime?
  mobile          String?
  email           String?
  familySize      Int?
  monthlyIncome   Decimal?    @db.Decimal(18, 2)
  monthlyExpenses Decimal?    @db.Decimal(18, 2)
  debtAmount      Decimal?    @db.Decimal(18, 2)
  housingStatus   String?
  housingOther    String?
  address         String?
  town            String?
  area            String?
  gham            String?
  husbandGham     String?
  fatherGham      String?
  education       String?
  profession      String?
  firm            String?
  remarks         String?
  photoUrl        String?     @db.Text
  cnicFrontUrl    String?     @db.Text
  cnicBackUrl     String?     @db.Text
  isActive        Boolean     @default(true)
  isDeleted       Boolean     @default(false)
  deletedAt       DateTime?
  deletedBy       String?     @db.Uuid
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  donations       Donation[]
  zakatCards      ZakatCard[]

  @@index([isDeleted])
}

model Donation {
  id             String         @id @default(uuid()) @db.Uuid
  beneficiaryId  String?        @db.Uuid
  beneficiary    Beneficiary?   @relation(fields: [beneficiaryId], references: [id])
  donorName      String?
  donorMobile    String?
  donationType       DonationType
  customDonationType String?
  amount             Decimal        @db.Decimal(18, 2)
  paymentMethod  PaymentMethod
  bankAccountId  String?        @db.Uuid
  bankAccount    Account?       @relation("DonationBankAccount", fields: [bankAccountId], references: [id])
  chequeNumber   String?
  donorBankName  String?
  remarks        String?
  status         DonationStatus @default(PENDING)
  createdById    String?        @db.Uuid
  createdBy      User?          @relation("DonationCreatedBy", fields: [createdById], references: [id])
  isDeleted      Boolean        @default(false)
  deletedAt      DateTime?
  deletedBy      String?        @db.Uuid
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([isDeleted])
  @@index([bankAccountId])
  @@index([beneficiaryId])
  @@index([createdAt])
}

// ── Simple Income ─────────────────────────────────────────────
model SimpleIncome {
  id             String      @id @default(uuid()) @db.Uuid
  date           DateTime    @default(now())
  revenueHeadId  String      @db.Uuid
  revenueHead    RevenueHead @relation(fields: [revenueHeadId], references: [id])
  description    String?
  amount         Decimal     @db.Decimal(18, 2)
  paymentMethod  String      @default("CASH")
  bankAccountId  String?     @db.Uuid
  reference      String?
  journalEntryId String?     @db.Uuid
  createdById    String?     @db.Uuid
  createdBy      User?       @relation("IncomeCreatedBy", fields: [createdById], references: [id])
  isDeleted      Boolean     @default(false)
  deletedAt      DateTime?
  deletedBy      String?     @db.Uuid
  createdAt      DateTime    @default(now())

  @@index([isDeleted])
  @@index([date])
  @@index([revenueHeadId])
  @@index([bankAccountId])
}

// ── Add Income Module ─────────────────────────────────────────
model IncomeCategory {
  id             String            @id @default(uuid()) @db.Uuid
  name           String            @unique
  description    String?
  // @unique: two categories must never share one GL account — otherwise
  // postings from different categories become indistinguishable in reports.
  accountId      String?           @unique @db.Uuid
  account        Account?          @relation(fields: [accountId], references: [id])
  isActive       Boolean           @default(true)
  isDeleted      Boolean           @default(false)
  deletedAt      DateTime?
  deletedBy      String?           @db.Uuid
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  incomeRecords  AddIncomeRecord[]

  @@index([isDeleted])
}

model AddIncomeRecord {
  id              String         @id @default(uuid()) @db.Uuid
  categoryId      String         @db.Uuid
  category        IncomeCategory @relation(fields: [categoryId], references: [id])
  subCategory     String?
  amount          Decimal        @db.Decimal(18, 2)
  date            DateTime       @default(now())
  paymentMethod   PaymentMethod  @default(CASH)
  bankAccountId   String?        @db.Uuid
  bankAccount     Account?       @relation("AddIncomeBankAccount", fields: [bankAccountId], references: [id])
  referenceNumber String?
  remarks         String?
  attachmentUrl   String?        @db.Text
  journalEntryId  String?        @unique @db.Uuid
  journalEntry    JournalEntry?  @relation("AddIncomeJournalEntry", fields: [journalEntryId], references: [id])
  createdById     String?        @db.Uuid
  createdBy       User?          @relation("AddIncomeCreatedBy", fields: [createdById], references: [id])
  status          String         @default("PENDING_POST")
  postedAt        DateTime?
  postedById      String?        @db.Uuid
  revertedAt      DateTime?
  revertedById    String?        @db.Uuid
  revertReason    String?
  isDeleted       Boolean        @default(false)
  deletedAt       DateTime?
  deletedBy       String?        @db.Uuid
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([isDeleted])
  @@index([date])
  @@index([categoryId])
  @@index([bankAccountId])
}

// ── Simple Expense ────────────────────────────────────────────
model SimpleExpense {
  id             String      @id @default(uuid()) @db.Uuid
  date           DateTime    @default(now())
  expenseHeadId  String      @db.Uuid
  expenseHead    ExpenseHead @relation(fields: [expenseHeadId], references: [id])
  paidTo         String?
  description    String?
  amount         Decimal     @db.Decimal(18, 2)
  paymentMethod  String      @default("CASH")
  bankAccountId  String?     @db.Uuid
  reference      String?
  journalEntryId String?     @db.Uuid
  createdById    String?     @db.Uuid
  createdBy      User?       @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  status         String      @default("PENDING_POST")
  postedAt       DateTime?
  postedById     String?     @db.Uuid
  revertedAt     DateTime?
  revertedById   String?     @db.Uuid
  revertReason   String?
  isDeleted      Boolean     @default(false)
  deletedAt      DateTime?
  deletedBy      String?     @db.Uuid
  createdAt      DateTime    @default(now())

  @@index([isDeleted])
  @@index([date])
  @@index([expenseHeadId])
  @@index([bankAccountId])
}

model HallBooking {
  id                String         @id @default(uuid()) @db.Uuid
  bookingDate       DateTime       @default(now())
  receiptNo         Int            @default(autoincrement())
  bookerName        String
  fatherHusbandName String?
  address           String?
  mobile            String?
  programDate       DateTime
  programType       String?
  functionType      String?
  timeFrom          String?
  timeTo            String?
  timings           String?
  hallId            String?        @db.Uuid
  hallAccount       Account?       @relation("HallBookingAccount", fields: [hallId], references: [id])
  isForJamaat       Boolean        @default(false)
  hallCharges       Decimal        @db.Decimal(18, 2)
  discount          Decimal        @default(0) @db.Decimal(18, 2)
  netAmount         Decimal?       @db.Decimal(18, 2)
  receivedAmount    Decimal?       @db.Decimal(18, 2)
  remainingAmount   Decimal?       @db.Decimal(18, 2)
  refundAmount      Decimal?       @default(0) @db.Decimal(18, 2)
  refundDate        DateTime?
  refundReason      String?
  paymentMethod     PaymentMethod
  bankAccountId     String?        @db.Uuid
  bankAccount       Account?       @relation("HallBookingBankAccount", fields: [bankAccountId], references: [id])
  chequeNumber      String?
  chequeBankName    String?
  status            String         @default("Confirmed")
  remarks           String?
  createdById       String?        @db.Uuid
  createdBy         User?          @relation("HallBookingCreatedBy", fields: [createdById], references: [id])
  journalEntryId    String?        @unique @db.Uuid
  journalEntry      JournalEntry?  @relation("HallBookingJournalEntry", fields: [journalEntryId], references: [id])
  isDeleted         Boolean        @default(false)
  deletedAt         DateTime?
  deletedBy         String?        @db.Uuid
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  // SQA fix: this was `@@unique([hallId, programDate])` — date-only — which
  // contradicted the app's own intent: HallBookingForm.jsx's own conflict
  // preview (client-side) already treats two different `timings` values
  // (e.g. "Morning" vs "Evening") on the same day as non-conflicting, but the
  // DB constraint blocked ANY second booking for that hall/date regardless of
  // timings, causing legitimate non-overlapping bookings to be rejected.
  // `timings` is now part of the key so distinct time slots can coexist.
  // NOTE: Postgres treats NULL as distinct from every other value in a unique
  // index, so two bookings with an unset `timings` would NOT be blocked by
  // this constraint alone — the application-level conflict check in
  // api/_v1/hall-bookings.ts (which also matches "Full Day" against any
  // timing, a rule this simple column-level index cannot express) remains
  // the primary safeguard; this index is a backstop for the exact-match case.
  // REQUIRES A MIGRATION: run `npm run db:push` (or `prisma migrate`) to
  // apply this constraint change — not run automatically as part of this fix.
  @@unique([hallId, programDate, timings], name: "hallId_programDate_timings")
  @@index([isDeleted])
  @@index([bankAccountId])
  @@index([createdById])
}

model Customer {
  id        String    @id @default(uuid()) @db.Uuid
  name      String
  email     String?
  phone     String?
  address   String?
  company   String?
  isActive  Boolean   @default(true)
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?   @db.Uuid
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  invoices  Invoice[]

  @@index([isDeleted])
}

model Invoice {
  id            String        @id @default(uuid()) @db.Uuid
  invoiceNo     String        @unique
  customerId    String        @db.Uuid
  customer      Customer      @relation(fields: [customerId], references: [id])
  issueDate     DateTime
  dueDate       DateTime
  status        String        @default("DRAFT") // DRAFT, POSTED, PAID, CANCELLED
  subtotal      Decimal       @db.Decimal(18, 2)
  discount      Decimal       @default(0) @db.Decimal(18, 2)
  tax           Decimal       @default(0) @db.Decimal(18, 2)
  total         Decimal       @db.Decimal(18, 2)
  paymentMethod String?       // CASH, BANK, CHEQUE
  bankAccountId String?       @db.Uuid
  bankAccount   Account?      @relation("InvoiceBankAccount", fields: [bankAccountId], references: [id])
  chequeNumber  String?
  remarks       String?
  items         InvoiceItem[]
  createdById   String?       @db.Uuid
  createdBy     User?         @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  isDeleted     Boolean       @default(false)
  deletedAt     DateTime?
  deletedBy     String?       @db.Uuid
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([isDeleted])
  @@index([customerId])
  @@index([issueDate])
  @@index([dueDate])
  @@index([status])
}

model InvoiceItem {
  id          String   @id @default(uuid()) @db.Uuid
  invoiceId   String   @db.Uuid
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Decimal  @db.Decimal(18, 2)
  unitPrice   Decimal  @db.Decimal(18, 2)
  amount      Decimal  @db.Decimal(18, 2)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RevenueCollection {
  id              String         @id @default(uuid()) @db.Uuid
  category        String         // "Zakat", "Fitra", "Membership Fee", "Bus Booking"
  receiptNo       Int            @default(autoincrement())
  title           String         // Donor Name / Member Name / Booker Name
  subTitle        String?        // CNIC / Member ID / Bus Number / Destination
  mobile          String?
  eventDate       DateTime?      // Trip Date / Fee Year / Collection Date
  quantity        Int?           // Head Count / Seats
  rate            Decimal?       @db.Decimal(18, 2) // Rate per Head / Fee Rate
  destination     String?
  amount          Decimal        @db.Decimal(18, 2)
  paymentMethod   PaymentMethod  @default(CASH)
  bankAccountId   String?        @db.Uuid
  bankAccount     Account?       @relation("RevenueCollectionBankAccount", fields: [bankAccountId], references: [id])
  chequeNumber    String?
  status          String         @default("Confirmed")
  remarks         String?
  createdById     String?        @db.Uuid
  createdBy       User?          @relation("RevenueCollectionCreatedBy", fields: [createdById], references: [id])
  journalEntryId  String?        @unique @db.Uuid
  journalEntry    JournalEntry?  @relation("RevenueCollectionJournalEntry", fields: [journalEntryId], references: [id])
  isDeleted       Boolean        @default(false)
  deletedAt       DateTime?
  deletedBy       String?        @db.Uuid
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([isDeleted])
  @@index([eventDate])
  @@index([bankAccountId])
}

model Member {
  id              String         @id @default(uuid()) @db.Uuid
  memberNo        String?        @unique
  fullName        String
  fatherName      String?
  cnic            String?        @unique
  dob             String?
  address         String?
  mobile          String?
  email           String?
  city            String?
  area            String?
  ghamName        String?
  education       String?
  profession      String?
  company         String?
  doi             String?
  photoUrl        String?        @db.Text
  cnicFrontUrl    String?        @db.Text
  cnicBackUrl     String?        @db.Text
  isActive        Boolean        @default(true)
  isDeleted       Boolean        @default(false)
  deletedAt       DateTime?
  deletedBy       String?        @db.Uuid
  zakatCards      ZakatCard[]
  familyLinksFrom FamilyRelationship[] @relation("MemberFamilyLinks")
  familyLinksTo   FamilyRelationship[] @relation("RelatedMemberFamilyLinks")
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([isDeleted])
}

enum FamilyRelationType {
  FATHER
  MOTHER
  HUSBAND
  WIFE
  SON
  DAUGHTER
  BROTHER
  SISTER
  GRANDFATHER
  GRANDMOTHER
  GRANDSON
  GRANDDAUGHTER
  UNCLE
  AUNT
  NEPHEW
  NIECE
  COUSIN
  GUARDIAN
  OTHER
}

// Normalized, bidirectional link between two Members. A single logical link
// (e.g. "A is Father of B") is stored as two rows — (A -> B, FATHER) and its
// automatically-derived reciprocal (B -> A, SON/DAUGHTER) — so that either
// member's family tree can be read with a single indexed query on memberId,
// with no runtime traversal/inference needed.
model FamilyRelationship {
  id               String             @id @default(uuid()) @db.Uuid
  memberId         String             @db.Uuid
  member           Member             @relation("MemberFamilyLinks", fields: [memberId], references: [id], onDelete: Cascade)
  relatedMemberId  String             @db.Uuid
  relatedMember    Member             @relation("RelatedMemberFamilyLinks", fields: [relatedMemberId], references: [id], onDelete: Cascade)
  relationshipType FamilyRelationType
  customLabel      String?
  isDeleted        Boolean            @default(false)
  deletedAt        DateTime?
  deletedBy        String?            @db.Uuid
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([memberId, relatedMemberId])
  @@index([memberId])
  @@index([relatedMemberId])
  @@index([isDeleted])
}

model ZakatCard {
  id              String         @id @default(uuid()) @db.Uuid
  memberId        String?        @db.Uuid
  member          Member?        @relation(fields: [memberId], references: [id])
  beneficiaryId   String?        @db.Uuid
  beneficiary     Beneficiary?   @relation(fields: [beneficiaryId], references: [id])
  zakatAmount     Decimal        @db.Decimal(18, 2)
  issueDate       DateTime       @default(now())
  cardNumber      String         @unique
  paymentMethod   PaymentMethod  @default(CASH)
  bankAccountId   String?        @db.Uuid
  journalEntryId  String?        @unique @db.Uuid
  journalEntry    JournalEntry?  @relation("ZakatCardJournalEntry", fields: [journalEntryId], references: [id])
  createdById     String?        @db.Uuid
  createdBy       User?          @relation("ZakatCardCreatedBy", fields: [createdById], references: [id])
  isDeleted       Boolean        @default(false)
  deletedAt       DateTime?
  deletedBy       String?        @db.Uuid
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([memberId])
  @@index([beneficiaryId])
  @@index([cardNumber])
  @@index([isDeleted])
}

model Donor {
  id              String   @id @default(uuid()) @db.Uuid
  donorCode       String   @unique
  fullName        String
  fatherName      String?
  mobile          String?
  cnic            String?  @unique
  email           String?
  address         String?
  city            String?
  isActive        Boolean  @default(true)
  isDeleted       Boolean  @default(false)
  deletedAt       DateTime?
  deletedBy       String?  @db.Uuid
  donations       DonationReceived[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([isDeleted])
}

model DonationReceived {
  id                String            @id @default(uuid()) @db.Uuid
  receiptNo         String            @unique
  receiptDate       DateTime          @default(now())
  donorId           String            @db.Uuid
  donor             Donor             @relation(fields: [donorId], references: [id])
  donationType      DonationType
  customDonationType String?
  amount            Decimal           @db.Decimal(18, 2)
  paymentMethod     PaymentMethod
  cashAccountId     String?           @db.Uuid
  cashAccount       Account?          @relation("DonationReceivedCashAccount", fields: [cashAccountId], references: [id])
  bankAccountId     String?           @db.Uuid
  bankAccount       Account?          @relation("DonationReceivedBankAccount", fields: [bankAccountId], references: [id])
  chequeNo          String?
  chequeDate        DateTime?
  referenceNo       String?
  narration         String?
  journalEntryId    String?           @unique @db.Uuid
  journalEntry      JournalEntry?     @relation("DonationReceivedJournalEntry", fields: [journalEntryId], references: [id])
  status            TransactionStatus @default(POSTED)
  createdById       String            @db.Uuid
  createdBy         User              @relation("DonationReceivedCreatedBy", fields: [createdById], references: [id])
  isDeleted         Boolean           @default(false)
  deletedAt         DateTime?
  deletedBy         String?           @db.Uuid
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([receiptDate])
  @@index([donorId])
  @@index([paymentMethod])
  @@index([isDeleted])
}
