generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id                   String         @id @default(uuid()) @db.Uuid
  fullName             String
  email                String         @unique
  password             String
  isActive             Boolean        @default(true)
  roleId               String         @db.Uuid
  role                 Role           @relation(fields: [roleId], references: [id])
  resetPasswordToken   String?
  resetPasswordExpires DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt
  refreshTokens        RefreshToken[]
  auditLogs            AuditLog[]
}

model Role {
  id              String           @id @default(uuid()) @db.Uuid
  name            String           @unique
  description     String?
  users           User[]
  rolePermissions RolePermission[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Permission {
  id              String           @id @default(uuid()) @db.Uuid
  name            String           @unique
  description     String?
  rolePermissions RolePermission[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model RolePermission {
  id           String     @id @default(uuid()) @db.Uuid
  roleId       String     @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String     @db.Uuid
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([roleId, permissionId])
}

model RefreshToken {
  id        String    @id @default(uuid()) @db.Uuid
  token     String    @unique
  userId    String    @db.Uuid
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
}

enum AccountLevel {
  MAIN
  PARENT
  SUBSIDIARY
}

model Account {
  id              String        @id @default(uuid()) @db.Uuid
  glCode          String        @unique
  accountName     String
  accountLevel    AccountLevel
  parentId        String?       @db.Uuid
  parent          Account?      @relation("AccountChildren", fields: [parentId], references: [id])
  children        Account[]     @relation("AccountChildren")
  accountTypeId   String?       @db.Uuid
  accountType     AccountType?  @relation(fields: [accountTypeId], references: [id])
  isLocked        Boolean       @default(false)
  isReserved      Boolean       @default(false)
  isSystemDefined Boolean       @default(false)
  description     String?
  currency        String        @default("USD")
  subsidiary      String[]      @default(["Global"])
  initialBalance  Float         @default(0)
  detailType      String        @default("Header")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  revenueHeads    RevenueHead[]
  expenseHeads    ExpenseHead[]
}

model AccountType {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique
  description String?
  accounts    Account[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ReservedCode {
  id            String   @id @default(uuid()) @db.Uuid
  reserveStart  String   @unique
  reserveEnd    String
  reserveReason String
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model RevenueHead {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  category    String
  accountId   String?  @db.Uuid
  account     Account? @relation(fields: [accountId], references: [id])
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model ExpenseHead {
  id          String   @id @default(uuid()) @db.Uuid
  name        String
  category    String
  accountId   String?  @db.Uuid
  account     Account? @relation(fields: [accountId], references: [id])
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String?  @db.Uuid
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  module    String
  oldValues Json?
  newValues Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
}
