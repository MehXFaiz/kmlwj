generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URI")
}

model User {
  id                       String              @id @default(uuid()) @map("_id")
  fullName                 String
  email                    String              @unique
  password                 String
  isActive                 Boolean             @default(true)
  roleId                   String
  role                     Role                @relation(fields: [roleId], references: [id])
  resetPasswordToken       String?
  resetPasswordExpires     DateTime?
  themePreference          String? // 'light' | 'dark' | 'system' — null = use client default
  isDeleted                Boolean             @default(false)
  deletedAt                DateTime?
  deletedBy                String?
  createdAt                DateTime            @default(now())
  updatedAt                DateTime            @updatedAt
  refreshTokens            RefreshToken[]
  auditLogs                AuditLog[]
  donationsCreated         Donation[]          @relation("DonationCreatedBy")
  hallBookingsCreated      HallBooking[]       @relation("HallBookingCreatedBy")
  incomesCreated           SimpleIncome[]      @relation("IncomeCreatedBy")
  expensesCreated          SimpleExpense[]     @relation("ExpenseCreatedBy")
  invoicesCreated          Invoice[]           @relation("InvoiceCreatedBy")
  revenueCollections       RevenueCollection[] @relation("RevenueCollectionCreatedBy")
  donationsReceivedCreated DonationReceived[]  @relation("DonationReceivedCreatedBy")
  zakatCardsCreated        ZakatCard[]         @relation("ZakatCardCreatedBy")
  addIncomesCreated        AddIncomeRecord[]   @relation("AddIncomeCreatedBy")
  pettyCashCreated         PettyCashTransaction[] @relation("PettyCashCreatedBy")
  pettyCashReconciled      PettyCashReconciliation[] @relation("PettyCashReconciledBy")
  pettyCashApproved        PettyCashReconciliation[] @relation("PettyCashApprovedBy")
  aiRepairLogs             AiRepairLog[]

  @@index([isDeleted])
}

model Role {
  id              String           @id @default(uuid()) @map("_id")
  name            String           @unique
  description     String?
  /// true only for Super Admin and Admin — grants full CRUD access.
  /// All other roles default to false (restricted: view + create only).
  isPrivileged    Boolean          @default(false)
  users           User[]
  rolePermissions RolePermission[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model Permission {
  id              String           @id @default(uuid()) @map("_id")
  name            String           @unique
  description     String?
  rolePermissions RolePermission[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
}

model RolePermission {
  id           String     @id @default(uuid()) @map("_id")
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@unique([roleId, permissionId])
}

model RefreshToken {
  id        String    @id @default(uuid()) @map("_id")
  token     String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime  @default(now())
  revokedAt DateTime?
}

enum AccountLevel {
  MAIN // Level 1 — Root categories (Assets, Liabilities, Revenue, Expenses)
  PARENT // Level 2 — Sub-categories (Current Assets, Hall Income, etc.)
  SUBSIDIARY // Level 3 — Posting groups / headers (Cash & Bank, Hall Booking, etc.)
  GL // Level 4 — Individual GL accounts (NBP Bank, Bagh-e-Hajiani, etc.) — User editable
}

model Account {
  id                     String              @id @default(uuid()) @map("_id")
  glCode                 String              @unique
  accountName            String
  accountLevel           AccountLevel
  parentId               String?
  parent                 Account?            @relation("AccountChildren", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children               Account[]           @relation("AccountChildren")
  accountTypeId          String?
  accountType            AccountType?        @relation(fields: [accountTypeId], references: [id])
  isLocked               Boolean             @default(false)
  isReserved             Boolean             @default(false)
  isSystemDefined        Boolean             @default(false)
  description            String?
  currency               String              @default("PKR")
  subsidiary             String[]            @default(["Global"])
  initialBalance         Float               @default(0)
  currentBalance         Float               @default(0)
  detailType             String              @default("Header")
  isDeleted              Boolean             @default(false)
  deletedAt              DateTime?
  deletedBy              String?
  createdAt              DateTime            @default(now())
  updatedAt              DateTime            @updatedAt
  revenueHeads           RevenueHead[]
  expenseHeads           ExpenseHead[]
  journalEntryLines      JournalEntryLine[]
  donations              Donation[]          @relation("DonationBankAccount")
  invoices               Invoice[]           @relation("InvoiceBankAccount")
  hallBookings           HallBooking[]       @relation("HallBookingAccount")
  hallBookingBanks       HallBooking[]       @relation("HallBookingBankAccount")
  revenueCollections     RevenueCollection[] @relation("RevenueCollectionBankAccount")
  donationsReceivedCash  DonationReceived[]  @relation("DonationReceivedCashAccount")
  donationsReceivedBank  DonationReceived[]  @relation("DonationReceivedBankAccount")
  incomeCategoryAccounts IncomeCategory[]
  addIncomeBanks         AddIncomeRecord[]   @relation("AddIncomeBankAccount")
  pettyCashConfigs       PettyCashConfig[]
  pettyCashAccounts      PettyCashTransaction[] @relation("PettyCashAccount")
  pettyCashSourceAccounts PettyCashTransaction[] @relation("PettyCashSourceAccount")
  pettyCashExpenseAccounts PettyCashTransaction[] @relation("PettyCashExpenseAccount")
  pettyCashReconciliations PettyCashReconciliation[]
  openingBalanceLines     OpeningBalanceLine[]

  @@index([parentId])
  @@index([accountLevel])
  @@index([isDeleted])
}

model AccountType {
  id          String    @id @default(uuid()) @map("_id")
  name        String    @unique
  description String?
  accounts    Account[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ReservedCode {
  id            String    @id @default(uuid()) @map("_id")
  reserveStart  String    @unique
  reserveEnd    String
  reserveReason String
  isActive      Boolean   @default(true)
  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?
  deletedBy     String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([isDeleted])
}

model RevenueHead {
  id            String         @id @default(uuid()) @map("_id")
  name          String
  category      String
  hall          String?
  amount        Float?         @default(0)
  accountId     String?
  account       Account?       @relation(fields: [accountId], references: [id])
  isActive      Boolean        @default(true)
  isDeleted     Boolean        @default(false)
  deletedAt     DateTime?
  deletedBy     String?
  createdAt     DateTime       @default(now())
  simpleIncomes SimpleIncome[]

  @@index([isDeleted])
}

model ExpenseHead {
  id             String          @id @default(uuid()) @map("_id")
  name           String
  category       String
  accountId      String?
  account        Account?        @relation(fields: [accountId], references: [id])
  isActive       Boolean         @default(true)
  isDeleted      Boolean         @default(false)
  deletedAt      DateTime?
  deletedBy      String?
  createdAt      DateTime        @default(now())
  simpleExpenses SimpleExpense[]
  pettyCashTransactions PettyCashTransaction[]

  @@index([isDeleted])
}

model AuditLog {
  id        String   @id @default(uuid()) @map("_id")
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  module    String
  oldValues Json?
  newValues Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([createdAt])
}

model JournalEntry {
  id                String             @id @default(uuid()) @map("_id")
  voucherNo         String             @unique
  postingDate       DateTime
  subsidiary        String
  reference         String
  description       String?
  postedBy          String
  status            String             @default("Draft")
  voucherType       String             @default("JV")
  isDeleted         Boolean            @default(false)
  deletedAt         DateTime?
  deletedBy         String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  lines             JournalEntryLine[]
  hallBooking       HallBooking?       @relation("HallBookingJournalEntry")
  revenueCollection RevenueCollection? @relation("RevenueCollectionJournalEntry")
  donationReceived  DonationReceived?  @relation("DonationReceivedJournalEntry")
  zakatCard         ZakatCard?         @relation("ZakatCardJournalEntry")
  addIncomeRecord   AddIncomeRecord?   @relation("AddIncomeJournalEntry")
  pettyCashTransaction PettyCashTransaction? @relation("PettyCashJournalEntry")
  openingBalanceBatch  OpeningBalanceBatch?  @relation("OpeningBalanceBatchJournalEntry")

  @@index([status, postingDate])
  @@index([voucherType, postingDate])
  @@index([isDeleted])
}

model JournalEntryLine {
  id             String       @id @default(uuid()) @map("_id")
  journalEntryId String
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  accountId      String
  account        Account      @relation(fields: [accountId], references: [id])
  description    String?
  debit          Float        @default(0)
  credit         Float        @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([accountId])
  @@index([journalEntryId])
}

enum DonationType {
  MONTHLY
  MARRIAGE
  MEDICAL
  EMERGENCY
  EDUCATION
  CUSTOM
  GENERAL_DONATION
  ZAKAT
  FITRA
  SADQA
  QURBANI
  HALL_DONATION
  MARRIAGE_DONATION
  BUILDING_FUND
  MEDICAL_DONATION
  EDUCATION_DONATION
}

enum PaymentMethod {
  CASH
  BANK
  CHEQUE
  ONLINE
}

enum TransactionStatus {
  DRAFT
  POSTED
  CANCELLED
}

enum DonationStatus {
  PENDING
  APPROVED
  CANCELLED
}

model Beneficiary {
  id              String      @id @default(uuid()) @map("_id")
  name            String
  fatherName      String?
  husbandName     String?
  cnic            String?     @unique
  dob             DateTime?
  mobile          String?
  email           String?
  familySize      Int?
  monthlyIncome   Float?
  monthlyExpenses Float?
  debtAmount      Float?
  housingStatus   String?
  housingOther    String?
  address         String?
  town            String?
  area            String?
  gham            String?
  husbandGham     String?
  fatherGham      String?
  education       String?
  profession      String?
  firm            String?
  remarks         String?
  photoUrl        String?
  cnicFrontUrl    String?
  cnicBackUrl     String?
  isActive        Boolean     @default(true)
  isDeleted       Boolean     @default(false)
  deletedAt       DateTime?
  deletedBy       String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  donations       Donation[]
  zakatCards      ZakatCard[]

  @@index([isDeleted])
}

model Donation {
  id                 String         @id @default(uuid()) @map("_id")
  beneficiaryId      String?
  beneficiary        Beneficiary?   @relation(fields: [beneficiaryId], references: [id])
  donorName          String?
  donorMobile        String?
  donationType       DonationType
  customDonationType String?
  amount             Float
  paymentMethod      PaymentMethod
  bankAccountId      String?
  bankAccount        Account?       @relation("DonationBankAccount", fields: [bankAccountId], references: [id])
  chequeNumber       String?
  donorBankName      String?
  remarks            String?
  status             DonationStatus @default(PENDING)
  createdById        String?
  createdBy          User?          @relation("DonationCreatedBy", fields: [createdById], references: [id])
  isDeleted          Boolean        @default(false)
  deletedAt          DateTime?
  deletedBy          String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([isDeleted])
  @@index([bankAccountId])
  @@index([beneficiaryId])
  @@index([createdAt])
}

model SimpleIncome {
  id             String      @id @default(uuid()) @map("_id")
  date           DateTime    @default(now())
  revenueHeadId  String
  revenueHead    RevenueHead @relation(fields: [revenueHeadId], references: [id])
  description    String?
  amount         Float
  paymentMethod  String      @default("CASH")
  bankAccountId  String?
  reference      String?
  journalEntryId String?
  createdById    String?
  createdBy      User?       @relation("IncomeCreatedBy", fields: [createdById], references: [id])
  isDeleted      Boolean     @default(false)
  deletedAt      DateTime?
  deletedBy      String?
  createdAt      DateTime    @default(now())

  @@index([isDeleted])
  @@index([date])
  @@index([revenueHeadId])
  @@index([bankAccountId])
}

model IncomeCategory {
  id            String            @id @default(uuid()) @map("_id")
  name          String            @unique
  description   String?
  accountId     String?           @unique
  account       Account?          @relation(fields: [accountId], references: [id])
  isActive      Boolean           @default(true)
  isDeleted     Boolean           @default(false)
  deletedAt     DateTime?
  deletedBy     String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  incomeRecords AddIncomeRecord[]

  @@index([isDeleted])
}

model AddIncomeRecord {
  id              String         @id @default(uuid()) @map("_id")
  categoryId      String
  category        IncomeCategory @relation(fields: [categoryId], references: [id])
  subCategory     String?
  amount          Float
  date            DateTime       @default(now())
  paymentMethod   PaymentMethod  @default(CASH)
  bankAccountId   String?
  bankAccount     Account?       @relation("AddIncomeBankAccount", fields: [bankAccountId], references: [id])
  referenceNumber String?
  remarks         String?
  attachmentUrl   String?
  journalEntryId  String?        @unique
  journalEntry    JournalEntry?  @relation("AddIncomeJournalEntry", fields: [journalEntryId], references: [id])
  createdById     String?
  createdBy       User?          @relation("AddIncomeCreatedBy", fields: [createdById], references: [id])
  status          String         @default("PENDING_POST")
  postedAt        DateTime?
  postedById      String?
  revertedAt      DateTime?
  revertedById    String?
  revertReason    String?
  isDeleted       Boolean        @default(false)
  deletedAt       DateTime?
  deletedBy       String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([isDeleted])
  @@index([date])
  @@index([categoryId])
  @@index([bankAccountId])
}

model SimpleExpense {
  id             String      @id @default(uuid()) @map("_id")
  date           DateTime    @default(now())
  expenseHeadId  String
  expenseHead    ExpenseHead @relation(fields: [expenseHeadId], references: [id])
  paidTo         String?
  description    String?
  amount         Float
  paymentMethod  String      @default("CASH")
  bankAccountId  String?
  reference      String?
  journalEntryId String?
  createdById    String?
  createdBy      User?       @relation("ExpenseCreatedBy", fields: [createdById], references: [id])
  status         String      @default("PENDING_POST")
  postedAt       DateTime?
  postedById     String?
  revertedAt     DateTime?
  revertedById   String?
  revertReason   String?
  isDeleted      Boolean     @default(false)
  deletedAt      DateTime?
  deletedBy      String?
  createdAt      DateTime    @default(now())

  @@index([isDeleted])
  @@index([date])
  @@index([expenseHeadId])
  @@index([bankAccountId])
}

model HallBooking {
  id                String        @id @default(uuid()) @map("_id")
  bookingDate       DateTime      @default(now())
  receiptNo         Int           @default(0)
  bookerName        String
  fatherHusbandName String?
  address           String?
  mobile            String?
  programDate       DateTime
  programType       String?
  functionType      String?
  timeFrom          String?
  timeTo            String?
  timings           String?
  hallId            String?
  hallAccount       Account?      @relation("HallBookingAccount", fields: [hallId], references: [id])
  isForJamaat       Boolean       @default(false)
  hallCharges       Float
  discount          Float         @default(0)
  netAmount         Float?
  receivedAmount    Float?
  remainingAmount   Float?
  refundAmount      Float?        @default(0)
  refundDate        DateTime?
  refundReason      String?
  paymentMethod     PaymentMethod
  bankAccountId     String?
  bankAccount       Account?      @relation("HallBookingBankAccount", fields: [bankAccountId], references: [id])
  chequeNumber      String?
  chequeBankName    String?
  status            String        @default("Confirmed")
  remarks           String?
  createdById       String?
  createdBy         User?         @relation("HallBookingCreatedBy", fields: [createdById], references: [id])
  journalEntryId    String?       @unique
  journalEntry      JournalEntry? @relation("HallBookingJournalEntry", fields: [journalEntryId], references: [id])
  isDeleted         Boolean       @default(false)
  deletedAt         DateTime?
  deletedBy         String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  @@unique([hallId, programDate, timings], name: "hallId_programDate_timings")
  @@index([isDeleted])
  @@index([bankAccountId])
  @@index([createdById])
}

model Customer {
  id        String    @id @default(uuid()) @map("_id")
  name      String
  email     String?
  phone     String?
  address   String?
  company   String?
  isActive  Boolean   @default(true)
  isDeleted Boolean   @default(false)
  deletedAt DateTime?
  deletedBy String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  invoices  Invoice[]

  @@index([isDeleted])
}

model Invoice {
  id            String        @id @default(uuid()) @map("_id")
  invoiceNo     String        @unique
  customerId    String
  customer      Customer      @relation(fields: [customerId], references: [id])
  issueDate     DateTime
  dueDate       DateTime
  status        String        @default("DRAFT") // DRAFT, POSTED, PAID, CANCELLED
  subtotal      Float
  discount      Float         @default(0)
  tax           Float         @default(0)
  total         Float
  paymentMethod String? // CASH, BANK, CHEQUE
  bankAccountId String?
  bankAccount   Account?      @relation("InvoiceBankAccount", fields: [bankAccountId], references: [id])
  chequeNumber  String?
  remarks       String?
  items         InvoiceItem[]
  createdById   String?
  createdBy     User?         @relation("InvoiceCreatedBy", fields: [createdById], references: [id])
  isDeleted     Boolean       @default(false)
  deletedAt     DateTime?
  deletedBy     String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([isDeleted])
  @@index([customerId])
  @@index([issueDate])
  @@index([dueDate])
  @@index([status])
}

model InvoiceItem {
  id          String   @id @default(uuid()) @map("_id")
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Float
  unitPrice   Float
  amount      Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model RevenueCollection {
  id             String        @id @default(uuid()) @map("_id")
  category       String // "Zakat", "Fitra", "Membership Fee", "Bus Booking"
  receiptNo      Int           @default(0)
  title          String // Donor Name / Member Name / Booker Name
  subTitle       String? // CNIC / Member ID / Bus Number / Destination
  mobile         String?
  eventDate      DateTime? // Trip Date / Fee Year / Collection Date
  quantity       Int? // Head Count / Seats
  rate           Float? // Rate per Head / Fee Rate
  destination    String?
  amount         Float
  paymentMethod  PaymentMethod @default(CASH)
  bankAccountId  String?
  bankAccount    Account?      @relation("RevenueCollectionBankAccount", fields: [bankAccountId], references: [id])
  chequeNumber   String?
  status         String        @default("Confirmed")
  remarks        String?
  createdById    String?
  createdBy      User?         @relation("RevenueCollectionCreatedBy", fields: [createdById], references: [id])
  journalEntryId String?       @unique
  journalEntry   JournalEntry? @relation("RevenueCollectionJournalEntry", fields: [journalEntryId], references: [id])
  isDeleted      Boolean       @default(false)
  deletedAt      DateTime?
  deletedBy      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([isDeleted])
  @@index([eventDate])
  @@index([bankAccountId])
}

model Member {
  id              String               @id @default(uuid()) @map("_id")
  memberNo        String?              @unique
  fullName        String
  fatherName      String?
  cnic            String?              @unique
  dob             String?
  address         String?
  mobile          String?
  email           String?
  city            String?
  area            String?
  ghamName        String?
  education       String?
  profession      String?
  company         String?
  doi             String?
  photoUrl        String?
  cnicFrontUrl    String?
  cnicBackUrl     String?
  isActive        Boolean              @default(true)
  isDeleted       Boolean              @default(false)
  deletedAt       DateTime?
  deletedBy       String?
  zakatCards      ZakatCard[]
  familyLinksFrom FamilyRelationship[] @relation("MemberFamilyLinks")
  familyLinksTo   FamilyRelationship[] @relation("RelatedMemberFamilyLinks")
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([isDeleted])
}

enum FamilyRelationType {
  FATHER
  MOTHER
  HUSBAND
  WIFE
  SON
  DAUGHTER
  BROTHER
  SISTER
  GRANDFATHER
  GRANDMOTHER
  GRANDSON
  GRANDDAUGHTER
  UNCLE
  AUNT
  NEPHEW
  NIECE
  COUSIN
  GUARDIAN
  OTHER
}

model FamilyRelationship {
  id               String             @id @default(uuid()) @map("_id")
  memberId         String
  member           Member             @relation("MemberFamilyLinks", fields: [memberId], references: [id], onDelete: Cascade)
  relatedMemberId  String
  relatedMember    Member             @relation("RelatedMemberFamilyLinks", fields: [relatedMemberId], references: [id], onDelete: Cascade)
  relationshipType FamilyRelationType
  customLabel      String?
  isDeleted        Boolean            @default(false)
  deletedAt        DateTime?
  deletedBy        String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([memberId, relatedMemberId])
  @@index([memberId])
  @@index([relatedMemberId])
  @@index([isDeleted])
}

model ZakatCard {
  id             String        @id @default(uuid()) @map("_id")
  memberId       String?
  member         Member?       @relation(fields: [memberId], references: [id])
  beneficiaryId  String?
  beneficiary    Beneficiary?  @relation(fields: [beneficiaryId], references: [id])
  zakatAmount    Float
  issueDate      DateTime      @default(now())
  cardNumber     String        @unique
  paymentMethod  PaymentMethod @default(CASH)
  bankAccountId  String?
  journalEntryId String?       @unique
  journalEntry   JournalEntry? @relation("ZakatCardJournalEntry", fields: [journalEntryId], references: [id])
  createdById    String?
  createdBy      User?         @relation("ZakatCardCreatedBy", fields: [createdById], references: [id])
  isDeleted      Boolean       @default(false)
  deletedAt      DateTime?
  deletedBy      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([memberId])
  @@index([beneficiaryId])
  @@index([isDeleted])
}

model Donor {
  id         String             @id @default(uuid()) @map("_id")
  donorCode  String             @unique
  fullName   String
  fatherName String?
  mobile     String?
  cnic       String?            @unique
  email      String?
  address    String?
  city       String?
  isActive   Boolean            @default(true)
  isDeleted  Boolean            @default(false)
  deletedAt  DateTime?
  deletedBy  String?
  donations  DonationReceived[]
  createdAt  DateTime           @default(now())
  updatedAt  DateTime           @updatedAt

  @@index([isDeleted])
}

model DonationReceived {
  id                 String            @id @default(uuid()) @map("_id")
  receiptNo          String            @unique
  receiptDate        DateTime          @default(now())
  donorId            String
  donor              Donor             @relation(fields: [donorId], references: [id])
  donationType       DonationType
  customDonationType String?
  amount             Float
  paymentMethod      PaymentMethod
  cashAccountId      String?
  cashAccount        Account?          @relation("DonationReceivedCashAccount", fields: [cashAccountId], references: [id])
  bankAccountId      String?
  bankAccount        Account?          @relation("DonationReceivedBankAccount", fields: [bankAccountId], references: [id])
  chequeNo           String?
  chequeDate         DateTime?
  referenceNo        String?
  narration          String?
  journalEntryId     String?           @unique
  journalEntry       JournalEntry?     @relation("DonationReceivedJournalEntry", fields: [journalEntryId], references: [id])
  status             TransactionStatus @default(POSTED)
  createdById        String
  createdBy          User              @relation("DonationReceivedCreatedBy", fields: [createdById], references: [id])
  isDeleted          Boolean           @default(false)
  deletedAt          DateTime?
  deletedBy          String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt

  @@index([receiptDate])
  @@index([donorId])
  @@index([paymentMethod])
  @@index([isDeleted])
}

model AiRepairIssue {
  id              String    @id @default(uuid()) @map("_id")
  type            String
  severity        String // 'critical' | 'warning' | 'info' — deterministic, never AI-assigned
  description     String
  entityRef       String? // human-readable pointer, e.g. GL code or voucher number
  currentValue    Float?
  expectedValue   Float?
  difference      Float?
  affectedRecords Json? // [{ model, id, ref }]
  status          String    @default("OPEN") // OPEN | ANALYZED | PENDING_APPROVAL | REJECTED | RESOLVED | REPAIR_FAILED
  detectedAt      DateTime  @default(now())
  lastSeenAt      DateTime  @default(now())
  resolvedAt      DateTime?

  aiRootCause          String?
  aiExplanation        String?
  aiConfidence         Float?
  aiRiskLevel          String? // LOW | MEDIUM | HIGH | CRITICAL — advisory only, never overrides the registry's fixed risk ceiling
  aiProposedRepairType String? // key into repair-operations.registry.ts, constrained by the AI tool schema's enum
  aiProposedChange     Json?
  aiModel              String?
  aiAnalyzedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([type])
  @@index([detectedAt])
}

model AiRepairLog {
  id                String   @id @default(uuid()) @map("_id")
  issueId           String?
  userId            String?
  user              User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action            String // AUTO_REPAIR_APPLIED | MANUAL_REPAIR_APPLIED | REPAIR_REJECTED | REPAIR_ROLLED_BACK | MANUAL_REVIEW_ACKNOWLEDGED
  issueType         String
  repairType        String
  rootCause         String?
  aiRecommendation  Json?
  oldValue          Json?
  newValue          Json?
  affectedRecords   Json?
  riskLevel         String
  approvalStatus    String // AUTO_APPROVED_LOW_RISK | ADMIN_APPROVED | REJECTED
  approvedById      String?
  beforeCheckResult Json?
  afterCheckResult  Json?
  rollbackStatus    String   @default("NOT_NEEDED") // NOT_NEEDED | ROLLED_BACK | ROLLBACK_FAILED
  success           Boolean
  errorMessage      String?
  createdAt         DateTime @default(now())

  @@index([createdAt])
  @@index([issueId])
}

model PettyCashConfig {
  id            String   @id @default(uuid()) @map("_id")
  accountId     String   @unique
  account       Account  @relation(fields: [accountId], references: [id])
  fundLimit     Float    @default(50000)
  custodianName String   @default("Authorized Custodian")
  status        String   @default("ACTIVE") // ACTIVE | SUSPENDED
  remarks       String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model PettyCashTransaction {
  id                 String       @id @default(uuid()) @map("_id")
  voucherNo          String       @unique
  transactionType    String // OPENING_BALANCE | TRANSFER_IN | TRANSFER_OUT | EXPENSE | REPLENISHMENT | ADMIN_ADJUSTMENT
  pettyCashAccountId String
  pettyCashAccount   Account      @relation("PettyCashAccount", fields: [pettyCashAccountId], references: [id])
  sourceAccountId    String?
  sourceAccount      Account?     @relation("PettyCashSourceAccount", fields: [sourceAccountId], references: [id])
  expenseAccountId   String?
  expenseAccount     Account?     @relation("PettyCashExpenseAccount", fields: [expenseAccountId], references: [id])
  expenseHeadId      String?
  expenseHead        ExpenseHead? @relation(fields: [expenseHeadId], references: [id])
  amount             Float
  date               DateTime     @default(now())
  paidTo             String?
  referenceNo        String?
  narration          String?
  attachmentUrl      String?
  journalEntryId     String?      @unique
  journalEntry       JournalEntry? @relation("PettyCashJournalEntry", fields: [journalEntryId], references: [id])
  createdById        String
  createdBy          User         @relation("PettyCashCreatedBy", fields: [createdById], references: [id])
  postedAt           DateTime?
  postedById         String?
  revertedAt         DateTime?
  revertedById       String?
  revertReason       String?
  isDeleted          Boolean      @default(false)
  deletedAt          DateTime?
  deletedBy          String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@index([isDeleted])
  @@index([date])
  @@index([pettyCashAccountId])
  @@index([transactionType])
}

model PettyCashReconciliation {
  id                 String    @id @default(uuid()) @map("_id")
  pettyCashAccountId String
  pettyCashAccount   Account   @relation(fields: [pettyCashAccountId], references: [id])
  reconciliationDate DateTime  @default(now())
  systemBalance      Float
  physicalCount      Float
  difference         Float
  explanation        String?
  status             String    @default("PENDING_APPROVAL") // PENDING_APPROVAL | APPROVED | REJECTED
  reconciledById     String
  reconciledBy       User      @relation("PettyCashReconciledBy", fields: [reconciledById], references: [id])
  approvedById       String?
  approvedBy         User?     @relation("PettyCashApprovedBy", fields: [approvedById], references: [id])
  approvedAt         DateTime?
  journalEntryId     String?   @unique
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([pettyCashAccountId])
  @@index([reconciliationDate])
}

model FinancialYear {
  id             String    @id @default(uuid()) @map("_id")
  code           String    @unique
  name           String
  startDate      DateTime
  endDate        DateTime
  isClosed       Boolean   @default(false)
  closedAt       DateTime?
  closedById     String?
  reopenedAt     DateTime?
  reopenedById   String?
  closingNotes   String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([startDate, endDate])
  @@index([isClosed])
}

model OpeningBalanceBatch {
  id                  String               @id @default(uuid()) @map("_id")
  openingDate         DateTime
  financialYear       String               @unique
  sourceFinancialYear String?
  sourceClosingDate   DateTime?
  isAutoRolled        Boolean              @default(false)
  adjustmentReason    String?
  adjustedById        String?
  adjustedAt          DateTime?
  status              String               @default("Posted")
  journalEntryId      String               @unique
  journalEntry        JournalEntry         @relation("OpeningBalanceBatchJournalEntry", fields: [journalEntryId], references: [id])
  createdBy           String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  lines               OpeningBalanceLine[]

  @@index([openingDate])
}

model OpeningBalanceLine {
  id                   String              @id @default(uuid()) @map("_id")
  batchId              String
  batch                OpeningBalanceBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)
  accountId            String
  account              Account             @relation(fields: [accountId], references: [id])
  glCode               String?
  debitCredit          String              @default("DEBIT")
  amount               Float
  sourceClosingBalance Float?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([batchId])
  @@index([accountId])
}
